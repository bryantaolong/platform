<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bryan.platform.mapper.algorithm.PostHotRankAlgorithmMapper">

    <sql id="BaseColumn">
        id,metric_key,metric_value,description,deleted,version,created_at,updated_at,created_by,updated_by
    </sql>

    <resultMap id="BaseResultMap" type="com.bryan.platform.domain.entity.algorithm.PostHotRankAlgorithm">
        <id column="id" property="id"/>
        <result column="metric_key" property="metricKey"/>
        <result column="metric_value" property="metricValue"/>
        <result column="description" property="description"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO post_algorithm (
            metric_key, metric_value, description, deleted, version,
            created_at, updated_at, created_by, updated_by
        ) VALUES (
                     #{metricKey}, #{metricValue}, #{description}, #{deleted}, #{version},
                     #{createdAt}, #{updatedAt}, #{createdBy}, #{updatedBy}
                 )
    </insert>

    <delete id="deleteById">
        UPDATE post_algorithm
        SET deleted = 1,
            updated_at = NOW()
        WHERE id = #{id}
          AND deleted = 0
    </delete>

    <update id="update">
        UPDATE post_algorithm
        <set>
            <if test="metricKey != null">metric_key = #{metricKey},</if>
            <if test="metricValue != null">metric_value = #{metricValue},</if>
            <if test="description != null">description = #{description},</if>
            version = #{version},
            updated_at = #{updatedAt},
            updated_by = #{updatedBy}
        </set>
        WHERE id = #{id}
          AND deleted = 0
    </update>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumn"/>
        FROM post_algorithm
        WHERE id = #{id} AND deleted = 0
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumn"/>
        FROM post_algorithm
        WHERE deleted = 0
    </select>

</mapper>
