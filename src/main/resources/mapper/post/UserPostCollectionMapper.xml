<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bryan.platform.mapper.post.UserPostCollectionMapper">

    <sql id="BaseColumn">
        id,user_id,folder_name,
        deleted,version,created_at,updated_at,created_by,updated_by
    </sql>

    <resultMap id="BaseResultMap" type="com.bryan.platform.domain.entity.post.UserPostCollection">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="folder_name" property="folderName"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_post_collection (
            user_id,folder_name,
            deleted,version,created_at,updated_at,created_by,updated_by
        ) VALUES (
                     #{userId},#{folderName},
                     #{deleted},#{version},#{createdAt},#{updatedAt},#{createdBy},#{updatedBy}
                 )
    </insert>

    <update id="deleteById">
        UPDATE user_post_collection
        SET deleted = 1,
            version = version + 1,
            updated_at = #{updatedAt},
            updated_by = #{updatedBy}
        WHERE id = #{id}
          AND deleted = 0
    </update>

    <update id="update">
        UPDATE user_post_collection
        SET folder_name = #{folderName},
            version = version + 1,
            updated_at = #{updatedAt},
            updated_by = #{updatedBy}
        WHERE id = #{id}
          AND version = #{version}
          AND deleted = 0
    </update>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumn"/>
        FROM user_post_collection
        WHERE id = #{id} AND deleted = 0
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumn"/>
        FROM user_post_collection
        WHERE user_id = #{userId}
        AND deleted = 0
        ORDER BY created_at ASC
    </select>

    <select id="selectByUserIdAndFolderName" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumn"/>
        FROM user_post_collection
        WHERE user_id = #{userId}
        AND folder_name = #{folderName}
        AND deleted = 0
    </select>

    <select id="countByUserId" resultType="long">
        SELECT COUNT(*)
        FROM user_post_collection
        WHERE user_id = #{userId}
          AND deleted = 0
    </select>

    <select id="existsByUserIdAndFolderName" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM user_post_collection
        WHERE user_id = #{userId}
          AND folder_name = #{folderName}
          AND deleted = 0
    </select>

</mapper>